<UserControl x:Class="Carrezance.Support.App.Views.OfficeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Outlook &amp; Office"/>
        <TextBlock Text="Accédez rapidement aux outils Microsoft 365 et aux actions simples pour Outlook."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

        <Border Style="{StaticResource Card}">
            <WrapPanel>
                <Button Content="Fermer Outlook bloqué" Command="{Binding CloseOutlookCommand}"/>
                <Button Content="Lancer Outlook en mode sans échec" Command="{Binding StartOutlookSafeModeCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Ouvrir Outlook Web" Command="{Binding OpenOutlookWebCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Ouvrir le portail Microsoft 365" Command="{Binding OpenOfficePortalCommand}" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LastActionBadge}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding ActionStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
