<UserControl x:Class="Carrezance.Support.App.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Diagnostic"/>
        <TextBlock Text="Vérifiez les informations principales du poste avant de contacter le support."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Lancer le diagnostic" Command="{Binding RunDiagnosticCommand}"/>
            <Button Content="Lancer un diagnostic complet" Command="{Binding RunFullDiagnosticCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Exporter rapport HTML" Command="{Binding ExportHtmlReportCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Ouvrir le dernier rapport HTML" Command="{Binding OpenLastHtmlReportCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Copier le chemin du dernier rapport HTML" Command="{Binding CopyLastHtmlReportPathCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Exporter un rapport TXT" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding DiagnosticProgressText, Mode=OneWay}" Foreground="{StaticResource NavyLightBrush}" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding DiagnosticProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding LastDiagnosticError, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
