<UserControl x:Class="Carrezance.Support.App.Views.PrinterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Imprimantes"/>
        <TextBlock Text="Affichez vos imprimantes ou relancez le service d'impression avec confirmation."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Réparer l'impression" Command="{Binding RepairPrintCommand}"/>
            <Button Content="Vider la file d'attente impression" Command="{Binding ClearQueueCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Afficher mes imprimantes" Command="{Binding ShowPrintersCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Ouvrir les paramètres imprimantes Windows" Command="{Binding OpenPrinterSettingsCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LastActionBadge}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding ActionStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Printers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MinHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Par défaut" Binding="{Binding IsDefault}" Width="110"/>
                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
