<UserControl x:Class="Carrezance.Support.App.Views.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Nettoyage"/>
        <TextBlock Text="Analysez l'espace disque et lancez un nettoyage simple des fichiers temporaires Windows."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Analyser l'espace disque" Command="{Binding AnalyzeDiskCommand}"/>
            <Button Content="Nettoyage simple" Command="{Binding CleanTempCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LastActionBadge}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <TextBlock Text="{Binding ActionStatus}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="État du disque"/>
                <TextBox Text="{Binding DiskSummary, Mode=OneWay}" IsReadOnly="True" MinHeight="120" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
