<UserControl x:Class="Carrezance.Support.App.Views.AssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Assistance"/>
        <TextBlock Text="Informations utiles à transmettre au support."
                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

        <WrapPanel Margin="0,0,0,12">
            <Button Content="Copier les informations" Command="{Binding CopyInfoCommand}"/>
            <Button Content="Exporter le rapport" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Exporter rapport HTML" Command="{Binding ExportHtmlReportCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Ouvrir le dossier du dernier rapport" Command="{Binding OpenLastReportFolderCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Copier le chemin du dernier rapport" Command="{Binding CopyLastReportPathCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Ouvrir le dernier rapport HTML" Command="{Binding OpenLastHtmlReportCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Copier le chemin du dernier rapport HTML" Command="{Binding CopyLastHtmlReportPathCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Ouvrir le dossier des logs" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource SecondaryButton}"/>
        </WrapPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Informations support"/>
                <ItemsControl ItemsSource="{Binding SupportItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="À propos"/>
                <ItemsControl ItemsSource="{Binding AboutItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <TextBlock Text="Emplacements prévus pour les prochaines versions : site web Carrezance, email support, outil de télémaintenance."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
