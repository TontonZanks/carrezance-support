<UserControl x:Class="Carrezance.Support.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Carrezance Support"/>
        <TextBlock Text="Cet outil permet de vérifier votre ordinateur, corriger certains problèmes simples et générer un rapport pour votre support."
                   Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,22"/>

        <UniformGrid Columns="3" Margin="0,0,0,18">
            <Button Content="Lancer un diagnostic rapide" Command="{Binding RunQuickDiagnosticCommand}" MinHeight="64" Margin="0,0,10,0"/>
            <Button Content="Réparer un problème courant" Command="{Binding RepairCommonIssueCommand}" MinHeight="64" Margin="0,0,10,0"/>
            <Button Content="Générer un rapport support" Command="{Binding ExportReportCommand}" MinHeight="64" Margin="0"/>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Réparations rapides"/>
                <UniformGrid Columns="4">
                    <Button Content="Réparer l'accès aux sites web" Command="{Binding RepairCommonIssueCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Réparer l'impression" Command="{Binding RepairPrintCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Fermer Outlook bloqué" Command="{Binding CloseOutlookCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Nettoyage simple" Command="{Binding CleanTempCommand}" Style="{StaticResource SecondaryButton}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding DiagnosticProgressText, Mode=OneWay}" Foreground="{StaticResource NavyLightBrush}" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding DiagnosticProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding LastDiagnosticError, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Informations rapides"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nom du poste" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding ComputerName}"/>
                    <TextBlock Grid.Row="1" Text="Utilisateur connecté" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserName}"/>
                    <TextBlock Grid.Row="2" Text="Version Windows" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WindowsVersion}"/>
                    <TextBlock Grid.Row="3" Text="État disque C:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskStatus}"/>
                    <TextBlock Grid.Row="4" Text="Connexion Internet" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InternetStatus}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
