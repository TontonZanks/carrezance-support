<Window x:Class="Carrezance.Support.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Carrezance.Support.App.ViewModels"
        xmlns:views="clr-namespace:Carrezance.Support.App.Views"
        Title="Carrezance Support" Height="760" Width="1180" MinHeight="680" MinWidth="980"
        Background="{StaticResource PageBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticViewModel}">
            <views:DiagnosticView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
            <views:PrinterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OfficeViewModel}">
            <views:OfficeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleaningViewModel}">
            <views:CleaningView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistanceViewModel}">
            <views:AssistanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TechnicianViewModel}">
            <views:TechnicianView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="148"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource NavyBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,20">
                    <TextBlock Text="Carrezance" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Support" Foreground="#B7C7DA" FontSize="14" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,18">
                    <TextBlock Text="{Binding ExecutionMode}"
                               Foreground="#E8EEF6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AppDisplayName}"
                               Foreground="#B7C7DA"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource SidebarButton}" Content="Accueil" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Diagnostic" Command="{Binding NavigateCommand}" CommandParameter="Diagnostic"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Internet &amp; Réseau" Command="{Binding NavigateCommand}" CommandParameter="Network"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Imprimantes" Command="{Binding NavigateCommand}" CommandParameter="Printer"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Outlook &amp; Office" Command="{Binding NavigateCommand}" CommandParameter="Office"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Nettoyage" Command="{Binding NavigateCommand}" CommandParameter="Cleaning"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Assistance" Command="{Binding NavigateCommand}" CommandParameter="Assistance"/>
                    <Button Style="{StaticResource SidebarButton}" Content="Mode technicien" Command="{Binding NavigateCommand}" CommandParameter="Technician"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="28"/>
        </ScrollViewer>

        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal des actions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding RecentLogs}" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource MutedTextBrush}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Historique des actions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding RepairActions}" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
